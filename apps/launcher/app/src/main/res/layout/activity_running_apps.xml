<?xml version="1.0" encoding="utf-8"?>
<!-- Running apps, a side sheet over whatever is on screen: the menu panel and rows of the Inputs dropdown
     (M3Skin), full height at the right edge, the app list scrolling between the heading and Stop all. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:tag="m3:panel"
        android:padding="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:text="@string/running_apps"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:fontFamily="@font/sans_headline" />

        <TextView
            android:id="@+id/summary"
            android:textColor="#B3FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:fontFamily="@font/sans_regular" />

        <TextView
            android:id="@+id/hint"
            android:textColor="#B3FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textSize="14sp"
            android:fontFamily="@font/sans_regular" />

        <com.gathin.tvhome.FocusScrollView
            android:id="@+id/rowsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.gathin.tvhome.FocusScrollView>

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
