<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings in Material 3 Expressive, Android 16 settings style: a hero column on the left
     (cookie badge and display title), grouped lists on the right. M3Skin paints it with the dynamic
     scheme: m3:choice rows become a connected button group, m3:listitem rows grouped list items. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FF141218"
    android:paddingStart="72dp"
    android:paddingEnd="72dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.36"
        android:paddingTop="40dp"
        android:paddingEnd="48dp"
        android:orientation="vertical">

        <com.gathin.tvhome.ShapeBadge
            android:id="@+id/settingsBadge"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="45sp"
            android:lineSpacingMultiplier="0.95"
            android:fontFamily="@font/sans_headline" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.64"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="true"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/columnsLabel"
                style="@style/SettingsGroupLabel"
                android:text="@string/columns_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsGroup">
                <TextView android:id="@+id/darkThemeChoice" style="@style/SettingsListItem" />
                <TextView android:id="@+id/widgetsChoice" style="@style/SettingsListItem" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsGroup">
                <TextView android:id="@+id/animationsChoice" style="@style/SettingsListItem" />
                <TextView android:id="@+id/advancedChoice" style="@style/SettingsListItem" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsGroup">
                <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsListItem" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
