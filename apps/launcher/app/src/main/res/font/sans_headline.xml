<?xml version="1.0" encoding="utf-8"?>
<!-- Google Sans Flex. The focused app's name above the dock: M3 display-small, half rounded. The axes are set here, once per process: android:fontVariationSettings on
     each TextView rebuilt the variable font for every view (about 10 ms each on a TV CPU). Android 8 ignores
     them and draws the default instance. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400, 'ROND' 60, 'opsz' 45"
        tools:targetApi="28" />
</font-family>
