<?xml version="1.0" encoding="utf-8"?>
<!-- Google Sans Flex. The clock: M3 display-large, emphasized and fully rounded as on Pixel. The axes are set here, once per process: android:fontVariationSettings on
     each TextView rebuilt the variable font for every view (about 10 ms each on a TV CPU). Android 8 ignores
     them and draws the default instance. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500, 'ROND' 100, 'opsz' 57"
        tools:targetApi="28" />
</font-family>
