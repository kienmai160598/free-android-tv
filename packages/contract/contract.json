{
  "launcher": {
    "package": "com.gathin.tvhome",
    "mainActivity": ".MainActivity",
    "inputKeyService": ".InputKeyService",
    "homeKeyService": ".HomeKeyService",
    "nowPlayingListener": ".NowPlayingListener"
  },
  "theme": {
    "directory": "/sdcard/Android/data/com.gathin.tvhome/files",
    "configFile": "config.json",
    "maxConfigBytes": 65536,
    "wallpaperFile": "wallpaper.jpg",
    "wallpapersDirectory": "wallpapers",
    "revisionFile": "theme_revision",
    "imageExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "maxWallpapers": 100,
    "maxWallpaperBytes": 10485760
  },
  "configKeys": [
    { "name": "dock_apps", "type": "packages" },
    { "name": "fill_dock", "type": "bool" },
    { "name": "hidden_apps", "type": "packages" },
    { "name": "live_tv_package", "type": "string" },
    { "name": "live_tv_action", "type": "string" },
    { "name": "source_panel_service", "type": "string" },
    { "name": "source_panel_action", "type": "string" },
    { "name": "input_action", "type": "string" },
    { "name": "columns", "type": "int", "min": 1, "max": 8 },
    { "name": "rows_below_dock", "type": "int", "min": 0, "max": 3 },
    { "name": "animations", "type": "bool" },
    { "name": "advanced_effects", "type": "bool" },
    { "name": "shamsi_date", "type": "bool" },
    { "name": "greeting_name", "type": "string" },
    { "name": "module_cards", "type": "bool" },
    { "name": "reduced_motion", "type": "bool" },
    { "name": "dock_title", "type": "bool" },
    { "name": "dock_row", "type": "bool" },
    { "name": "reorder_button", "type": "bool" },
    { "name": "vpn_app", "type": "string" },
    { "name": "show_home_settings_shortcut", "type": "bool" },
    { "name": "show_stats", "type": "bool" },
    { "name": "app_library", "type": "bool" },
    { "name": "background_color", "type": "color" },
    { "name": "sky_intensity", "type": "int", "min": 0, "max": 100 },
    { "name": "settings_key_keycodes", "type": "keycodes" },
    { "name": "settings_key_panel", "type": "bool" },
    { "name": "input_key_keycodes", "type": "keycodes" },
    { "name": "app_keys", "type": "strings" },
    { "name": "wallpaper", "type": "bool" },
    { "name": "wallpaper_rotation_minutes", "type": "int", "min": 0, "max": 1440 },
    { "name": "wallpaper_dim", "type": "int", "min": 0, "max": 90 },
    { "name": "festival", "type": "string" },
    { "name": "festival_until", "type": "date" },
    { "name": "greeting", "type": "string" },
    { "name": "accent_color", "type": "color" }
  ]
}
